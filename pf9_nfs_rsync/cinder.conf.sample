# Sample [backend] stanza for the PF9 NFS+rsync replication driver.
# Copy into /opt/pf9/etc/pf9-cindervolume-base/conf.d/cinder.conf and add the
# backend to enabled_backends. Restart pf9-cindervolume-base after editing.
#
# NOTE the class path — the driver ships as a package (pf9_nfs_rsync/), so the
# module is pf9_nfs_rsync.pf9_nfs_rsync, NOT a bare pf9_nfs_rsync.

[DEFAULT]
enabled_backends = psr-dr

[psr-dr]
volume_driver = cinder.volume.drivers.pf9_nfs_rsync.pf9_nfs_rsync.PF9NFSRsyncDriver
volume_backend_name = psr-dr

# --- NFS backing store (this site's export) ---
nfs_shares_config = /etc/cinder/pf9_nfs_shares      # one line: <host>:/export/psr
nas_secure_file_operations = false
nas_secure_file_permissions = false
nfs_snapshot_support = true                         # enables snapshot -> test-volume
                                                    # (test-without-failover)

# --- replication target (the secondary site) ---
# backend_id is referenced by failover; export is this driver's own key.
replication_device = backend_id:pf9-nfs-secondary,export:/export/psr

# --- in-driver replication thread (replaces the old pf9_rsync_loop.sh) ---
# Leave pf9_replication_peer unset on a single-site / CI box: the thread idles.
pf9_replication_peer = ubuntu@10.10.7.166           # ssh target of the secondary NFS server
pf9_replication_peer_incoming = /export/psr/incoming
pf9_replication_interval = 30                        # seconds between ship+flip cycles
pf9_replication_keep_gens = 3                        # generations (journal depth) kept on secondary
